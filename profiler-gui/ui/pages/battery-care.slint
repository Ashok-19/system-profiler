import { Theme } from "../theme.slint";
import { Icons } from "../icons.slint";
import { Device, Live } from "../state.slint";
import { SectionHeader, SettingRow, SettingsSection, ChoiceCard, StepSlider, OutlineButton } from "../widgets/common.slint";

// Large battery outline filled to the charge level.
component BatteryGauge inherits Rectangle {
    in property <int> percent;
    width: 156px;
    height: 70px;
    Rectangle {
        width: 150px;
        border-width: 2px;
        border-color: #cfcfcf;
        border-radius: Theme.radius;
        Rectangle {
            x: 7px;
            y: 7px;
            width: max(0px, (parent.width - 14px) * min(100, root.percent) / 100);
            height: parent.height - 14px;
            background: @linear-gradient(90deg, Theme.accent-dark 0%, Theme.accent 100%);
        }
    }

    Rectangle {
        x: 150px;
        y: (parent.height - self.height) / 2;
        width: 6px;
        height: 22px;
        background: #cfcfcf;
    }
}

// "key ........ value" with a hairline under it.
component DetailRow inherits Rectangle {
    in property <string> key;
    in property <string> value;
    min-height: 42px;
    Rectangle {
        y: parent.height - 1px;
        height: 1px;
        background: Theme.hair;
    }

    HorizontalLayout {
        Text {
            text: root.key;
            font-size: 14px * Theme.text-scale;
            color: Theme.text-muted;
            vertical-alignment: center;
        }

        Text {
            text: root.value;
            font-size: 14px * Theme.text-scale;
            color: Theme.text;
            horizontal-alignment: right;
            vertical-alignment: center;
        }
    }
}

export component BatteryCarePage inherits VerticalLayout {
    property <bool> can-limit: Device.daemon-ok && Device.charge-limit > 0;

    property <bool> one-shot-active: Device.one-shot-from > 0 && Device.charge-limit == 100;

    function set-limit(limit: int) {
        Device.one-shot-from = -1;
        Device.charge-limit = limit;
        Device.set-charge-limit(limit);
    }

    spacing: 34px;
    alignment: start;

    HorizontalLayout {
        spacing: 48px;

        // Battery status.
        VerticalLayout {
            min-width: 320px;
            horizontal-stretch: 1;
            spacing: 22px;
            alignment: start;
            SectionHeader { title: "Battery Status"; }
            HorizontalLayout {
                padding-left: 20px;
                spacing: 22px;
                alignment: start;
                BatteryGauge { percent: max(0, Live.battery-percent); }
                VerticalLayout {
                    alignment: center;
                    spacing: 6px;
                    Text {
                        text: Live.battery-percent >= 0 ? Live.battery-percent + "%" : "—";
                        font-size: 44px * Theme.text-scale;
                        font-weight: 300;
                        color: Theme.text-strong;
                    }

                    Text {
                        text: Live.battery-status;
                        font-size: 13px * Theme.text-scale;
                        color: #bdbdbd;
                    }
                }
            }

            VerticalLayout {
                padding-left: 20px;
                for fact in Live.battery-facts: DetailRow {
                    key: fact.key;
                    value: fact.value;
                }
            }
        }

        // Charge limit presets.
        VerticalLayout {
            min-width: 420px;
            horizontal-stretch: 1.3;
            spacing: 18px;
            alignment: start;
            SectionHeader { title: "Battery Charging Mode"; }
            VerticalLayout {
                padding-left: 20px;
                spacing: 10px;
                ChoiceCard {
                    label: "Full Capacity Mode";
                    description: "Charges to 100% for the longest time away from the charger.";
                    checked: Device.charge-limit == 100;
                    enabled: root.can-limit;
                    clicked => { root.set-limit(100); }
                }

                ChoiceCard {
                    label: "Balanced Mode";
                    description: "Stops at 80% to slow battery wear when you are often plugged in.";
                    checked: Device.charge-limit == 80;
                    enabled: root.can-limit;
                    clicked => { root.set-limit(80); }
                }

                ChoiceCard {
                    label: "Maximum Lifespan Mode";
                    description: "Stops at 60%. Best when the laptop stays plugged in on a desk.";
                    checked: Device.charge-limit == 60;
                    enabled: root.can-limit;
                    clicked => { root.set-limit(60); }
                }

                if !root.can-limit: Text {
                    text: Device.daemon-ok ? "This laptop does not report a charge limit." : "asusd is not running, so the charge limit cannot be changed.";
                    font-size: 13px * Theme.text-scale;
                    color: Theme.text-dim;
                    wrap: word-wrap;
                }
            }
        }
    }

    SettingsSection {
        title: "Custom Limit";
        hint: "Stored by asusd and kept across restarts";
        SettingRow {
            shaded: true;
            icon: Icons.battery-small;
            label: "Charge limit";
            sub: "Charging stops at this level while plugged in";
            dimmed: !root.can-limit;
            StepSlider {
                label: "Charge limit";
                minimum: 20;
                maximum: 100;
                step: 5;
                unit: "%";
                value: max(20, Device.charge-limit);
                enabled: root.can-limit;
                committed(limit) => { root.set-limit(limit); }
            }
        }

        SettingRow {
            icon: Icons.bolt;
            label: "Charge to 100% once";
            sub: root.one-shot-active
                ? "Charging to 100% now. Your " + Device.one-shot-from + "% limit comes back when you unplug."
                : Device.charge-limit == 100
                ? "Available while a charge limit is set"
                : "Your " + Device.charge-limit + "% limit comes back when you unplug";
            dimmed: !root.can-limit || Device.charge-limit == 100;
            OutlineButton {
                text: root.one-shot-active ? "Charging…" : "Charge Now";
                enabled: root.can-limit && Device.charge-limit < 100;
                clicked => {
                    Device.one-shot-from = Device.charge-limit;
                    Device.charge-limit = 100;
                    Device.one-shot-charge();
                }
            }
        }
    }
}
