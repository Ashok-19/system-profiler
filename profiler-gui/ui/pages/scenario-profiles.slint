import { Theme, Prefs } from "../theme.slint";
import { Icons } from "../icons.slint";
import { Device, Lighting, Profiles, ProfileData } from "../state.slint";
import { SectionHeader, SettingRow, SettingsSection, Switch, Select, OutlineButton, BracketPanel, TextField } from "../widgets/common.slint";

global Describe {
    public pure function summary(p: ProfileData) -> string {
        return Describe.join([
            p.mode == 0 ? "Silent" : p.mode == 1 ? "Performance" : p.mode == 2 ? "Turbo" : "",
            p.charge-limit > 0 ? "Charge to " + p.charge-limit + "%" : "",
            p.refresh == 0 ? "Fastest refresh" : p.refresh == 1 ? "Slowest refresh" : "",
            p.keyboard == 0 ? "Keyboard off" : p.keyboard == 1 ? "Keyboard low" : p.keyboard == 2 ? "Keyboard medium" : p.keyboard == 3 ? "Keyboard high" : "",
        ]);
    }

    // Non-empty parts joined with " · ".
    pure function join(parts: [string]) -> string {
        return Describe.add(Describe.add(Describe.add(parts[0], parts[1]), parts[2]), parts[3]) == ""
            ? "Changes nothing yet"
            : Describe.add(Describe.add(Describe.add(parts[0], parts[1]), parts[2]), parts[3]);
    }

    pure function add(a: string, b: string) -> string {
        return a == "" ? b : b == "" ? a : a + " · " + b;
    }
}

component ProfileCard inherits Rectangle {
    in property <int> index;
    callback edit();
    property <ProfileData> p: Profiles.list[root.index];
    property <bool> active: Profiles.active == root.index;

    horizontal-stretch: 1;
    min-width: 0px;
    preferred-width: 1px;
    border-radius: Theme.radius;
    border-width: 1px;
    border-color: root.active ? Theme.accent : #3a3a3a;
    background: root.active
        ? @linear-gradient(90deg, Theme.accent.with-alpha(0.22 * Theme.glow) 0%, Theme.panel 80%)
        : Theme.panel;

    VerticalLayout {
        padding: 18px;
        spacing: 10px;
        alignment: start;
        HorizontalLayout {
            spacing: 10px;
            min-height: 26px;
            Text {
                text: root.p.name;
                font-size: 17px * Theme.text-scale;
                font-weight: 600;
                color: Theme.text-strong;
                vertical-alignment: center;
                overflow: elide;
                horizontal-stretch: 1;
            }

            if root.active: VerticalLayout {
                alignment: center;
                Rectangle {
                    background: Theme.accent;
                    border-radius: Theme.radius / 2;
                    HorizontalLayout {
                        padding-left: 8px;
                        padding-right: 8px;
                        padding-top: 2px;
                        padding-bottom: 2px;
                        Text {
                            text: "ACTIVE";
                            font-size: 11px * Theme.text-scale;
                            font-weight: 700;
                            color: #120c02;
                        }
                    }
                }
            }

            if root.p.apps != "": Switch {
                label: "Apply " + root.p.name + " automatically";
                checked: root.p.enabled;
                toggled(on) => {
                    Profiles.list[root.index] = {
                        name: root.p.name, enabled: on, apps: root.p.apps, mode: root.p.mode,
                        charge-limit: root.p.charge-limit, refresh: root.p.refresh, keyboard: root.p.keyboard,
                    };
                    Prefs.save();
                }
            }
        }

        Text {
            text: root.p.apps == "" ? "Applied manually" : "When " + root.p.apps + " is running";
            font-size: 13px * Theme.text-scale;
            color: #bdbdbd;
            overflow: elide;
        }

        Text {
            text: Describe.summary(root.p);
            font-size: 13px * Theme.text-scale;
            color: #dadada;
            overflow: elide;
        }

        HorizontalLayout {
            spacing: 10px;
            alignment: start;
            padding-top: 4px;
            OutlineButton {
                text: "Apply";
                clicked => { Profiles.apply(root.index); }
            }

            OutlineButton {
                text: "Edit";
                clicked => { root.edit(); }
            }
        }
    }
}

export component ScenarioProfilesPage inherits HorizontalLayout {
    property <int> editing: -1;
    property <string> e-name;
    property <string> e-apps;
    property <bool> e-enabled;
    property <int> e-mode;
    property <int> e-limit;
    property <int> e-refresh;
    property <int> e-keyboard;
    property <[int]> limits: [0, 100, 80, 60];

    function edit(i: int) {
        root.editing = i;
        root.e-name = Profiles.list[i].name;
        root.e-apps = Profiles.list[i].apps;
        root.e-enabled = Profiles.list[i].enabled;
        root.e-mode = Profiles.list[i].mode;
        root.e-limit = Profiles.list[i].charge-limit;
        root.e-refresh = Profiles.list[i].refresh;
        root.e-keyboard = Profiles.list[i].keyboard;
    }

    function save() {
        Profiles.list[root.editing] = {
            name: root.e-name == "" ? "Untitled" : root.e-name,
            enabled: root.e-enabled,
            apps: root.e-apps,
            mode: root.e-mode,
            charge-limit: root.e-limit,
            refresh: root.e-refresh,
            keyboard: root.e-keyboard,
        };
        Prefs.save();
        root.editing = -1;
    }

    // Content stops at 1080 px; the filler takes the rest so the page
    // never limits the window's width.
    VerticalLayout {
        max-width: 1080px;
        horizontal-stretch: 1;
        spacing: 34px;
        alignment: start;

        VerticalLayout {
            spacing: 16px;
            HorizontalLayout {
                SectionHeader { title: "Profiles"; }
                Rectangle { horizontal-stretch: 1; }
                OutlineButton {
                    text: "+ New Profile";
                    clicked => {
                        Profiles.add();
                        root.edit(Profiles.list.length - 1);
                    }
                }
            }

            VerticalLayout {
                padding-left: 20px;
                spacing: 14px;
                for row in Math.ceil(Profiles.list.length / 2): HorizontalLayout {
                    spacing: 14px;
                    ProfileCard {
                        index: row * 2;
                        edit => { root.edit(row * 2); }
                    }

                    if row * 2 + 1 < Profiles.list.length: ProfileCard {
                        index: row * 2 + 1;
                        edit => { root.edit(row * 2 + 1); }
                    }

                    if row * 2 + 1 >= Profiles.list.length: Rectangle {
                        horizontal-stretch: 1;
                        min-width: 0px;
                        preferred-width: 1px;
                    }
                }
            }
        }

        if root.editing >= 0: HorizontalLayout {
            padding-left: 20px;
            BracketPanel {
                Text {
                    text: "Edit Profile";
                    font-size: 16px * Theme.text-scale;
                    font-weight: 600;
                    color: Theme.text-strong;
                }

                SettingRow {
                    shaded: true;
                    label: "Name";
                    TextField {
                        width: 300px;
                        label: "Profile name";
                        text: root.e-name;
                        edited(t) => { root.e-name = t; }
                    }
                }

                SettingRow {
                    label: "Apps that turn it on";
                    sub: "Process names, comma separated, e.g. steam, lutris. Empty: apply it by hand.";
                    TextField {
                        width: 300px;
                        label: "Trigger apps";
                        placeholder: "steam, lutris";
                        text: root.e-apps;
                        edited(t) => { root.e-apps = t; }
                    }
                }

                SettingRow {
                    shaded: true;
                    icon: Icons.mode;
                    label: "Operating mode";
                    Select {
                        width: 300px;
                        options: ["Keep current", "Silent", "Performance", "Turbo"];
                        current-index: root.e-mode + 1;
                        selected(i) => { root.e-mode = i - 1; }
                    }
                }

                SettingRow {
                    icon: Icons.battery-small;
                    label: "Charge limit";
                    Select {
                        width: 300px;
                        options: ["Keep current", "Full Capacity (100%)", "Balanced (80%)", "Maximum Lifespan (60%)"];
                        current-index: root.e-limit == 0 ? 0 : root.e-limit == 100 ? 1 : root.e-limit == 80 ? 2 : root.e-limit == 60 ? 3 : -1;
                        placeholder: root.e-limit + "%";
                        selected(i) => { root.e-limit = root.limits[i]; }
                    }
                }

                SettingRow {
                    shaded: true;
                    icon: Icons.display;
                    label: "Refresh rate";
                    Select {
                        width: 300px;
                        options: ["Keep current", "Fastest", "Slowest"];
                        current-index: root.e-refresh + 1;
                        selected(i) => { root.e-refresh = i - 1; }
                    }
                }

                SettingRow {
                    icon: Icons.light;
                    label: "Keyboard backlight";
                    dimmed: !Lighting.available;
                    Select {
                        width: 300px;
                        options: ["Keep current", "Off", "Low", "Medium", "High"];
                        current-index: root.e-keyboard + 1;
                        selected(i) => { root.e-keyboard = i - 1; }
                    }
                }

                HorizontalLayout {
                    spacing: 12px;
                    alignment: end;
                    OutlineButton {
                        text: "Delete";
                        clicked => {
                            Profiles.remove(root.editing);
                            root.editing = -1;
                        }
                    }

                    OutlineButton {
                        text: "Cancel";
                        clicked => { root.editing = -1; }
                    }

                    OutlineButton {
                        text: "Save";
                        primary: true;
                        clicked => { root.save(); }
                    }
                }
            }
        }

        SettingsSection {
            title: "Automation";
            SettingRow {
                shaded: true;
                icon: Icons.profiles;
                label: "Apply profiles automatically when their apps start";
                sub: "Your previous settings come back when the apps close. Works while System Profiler is running.";
                Switch {
                    label: "Apply profiles automatically";
                    checked: Profiles.auto;
                    toggled(on) => {
                        Profiles.auto = on;
                        Prefs.save();
                    }
                }
            }
        }
    }

    Rectangle {
        horizontal-stretch: 0.001;
    }
}
