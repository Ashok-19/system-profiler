import { Theme, Prefs } from "../theme.slint";
import { Icons } from "../icons.slint";
import { Live, Screen } from "../state.slint";
import { SectionHeader, SettingRow, SettingsSection, Switch, KeyValue, ModeTab } from "../widgets/common.slint";

export component DisplayPage inherits HorizontalLayout {
    property <int> slowest: Screen.rates.length - 1;
    property <string> description: Screen.current < 0 ? ""
        : Screen.current == 0 ? "Smoothest motion for games and fast scrolling. Uses the most power."
        : Screen.current == root.slowest ? "Standard rate with the longest battery life."
        : "A balance between smooth motion and battery life.";

    function pick(index: int) {
        Screen.current = index;
        Screen.busy = true;
        Screen.set-rate(index);
    }

    // xrandr and xinput are only asked when the page opens.
    init => {
        Screen.refresh();
    }

    // Content stops at 1080 px; the filler takes the rest so the page
    // never limits the window's width.
    VerticalLayout {
        max-width: 1080px;
        horizontal-stretch: 1;
        spacing: 34px;
        alignment: start;

        if !Screen.available: Text {
            text: "Refresh rate control needs an X11 session with xrandr.";
            font-size: 14px * Theme.text-scale;
            color: Theme.text-dim;
        }

        if Screen.available: VerticalLayout {
            spacing: 18px;
            SectionHeader { title: "Refresh Rate"; }
            HorizontalLayout {
                padding-left: 20px;
                Rectangle {
                    Rectangle {
                        y: parent.height - 1px;
                        height: 1px;
                        background: Theme.line;
                    }

                    HorizontalLayout {
                        for rate[i] in Screen.rates: ModeTab {
                            label: rate;
                            icon: Icons.display;
                            icon-size: 34px;
                            selected: Screen.current == i;
                            enabled: !Screen.busy;
                            clicked => { root.pick(i); }
                        }
                    }
                }
            }

            HorizontalLayout {
                padding-left: 20px;
                spacing: 40px;
                Text {
                    min-width: 280px;
                    horizontal-stretch: 1;
                    text: root.description;
                    font-size: 14px * Theme.text-scale;
                    color: #cfcfcf;
                    wrap: word-wrap;
                }

                VerticalLayout {
                    width: 300px;
                    spacing: 4px;
                    KeyValue {
                        key: "Panel";
                        value: Screen.size != "" ? Screen.size + " · " + Screen.resolution : Screen.resolution;
                    }

                    KeyValue {
                        key: "Output";
                        value: Screen.output;
                    }

                    KeyValue {
                        key: "Set with";
                        value: "xrandr (X11)";
                    }
                }
            }
        }

        if Screen.available: SettingsSection {
            title: "Power Saving";
            SettingRow {
                shaded: true;
                icon: Icons.battery-small;
                label: "Use the slowest rate on battery";
                sub: "Back to the fastest rate when plugged in. Applies while System Profiler is running.";
                Switch {
                    label: "Use the slowest refresh rate on battery";
                    checked: Prefs.battery-60hz;
                    toggled(on) => {
                        Prefs.battery-60hz = on;
                        Prefs.save();
                        if on && !Live.on-ac && Screen.current != root.slowest {
                            root.pick(root.slowest);
                        }
                    }
                }
            }
        }

        if Screen.has-touchpad: SettingsSection {
            title: "Touchpad";
            SettingRow {
                shaded: true;
                icon: Icons.touchpad;
                label: "Touchpad";
                sub: Screen.touchpad-name;
                Switch {
                    label: "Touchpad";
                    checked: Screen.touchpad-on;
                    enabled: !Screen.busy;
                    toggled(on) => {
                        Screen.touchpad-on = on;
                        Screen.busy = true;
                        Screen.set-touchpad(on);
                    }
                }
            }
        }
    }

    Rectangle {
        horizontal-stretch: 0.001;
    }
}
