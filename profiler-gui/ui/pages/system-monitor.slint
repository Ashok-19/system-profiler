import { Theme } from "../theme.slint";
import { Live, Chart } from "../state.slint";
import { SectionHeader, Segmented } from "../widgets/common.slint";

component ChartBlock inherits VerticalLayout {
    in property <Chart> chart;
    in property <string> span;
    min-width: 300px;
    horizontal-stretch: 1;
    spacing: 10px;

    HorizontalLayout {
        Text {
            text: root.chart.title;
            font-size: 22px;
            font-weight: 300;
            color: Theme.text;
        }

        Text {
            text: root.chart.now;
            font-size: 22px;
            font-weight: 300;
            color: Theme.text-strong;
            horizontal-alignment: right;
        }
    }

    Rectangle {
        height: 130px;
        background: @linear-gradient(180deg, Theme.panel 0%, Theme.bg 100%);
        accessible-role: image;
        accessible-label: root.chart.title + " history, now " + root.chart.now;

        for fraction in [0.25, 0.5, 0.75]: Rectangle {
            y: parent.height * fraction;
            height: 1px;
            background: Theme.hair;
        }

        if root.chart.area != "": Path {
            width: parent.width;
            height: parent.height;
            viewbox-width: 300;
            viewbox-height: 100;
            // Stretch the 300 x 100 chart to the box.
            fit: fill;
            commands: root.chart.area;
            fill: Theme.accent.with-alpha(0.12);
            stroke-width: 0px;
        }

        if root.chart.line != "": Path {
            width: parent.width;
            height: parent.height;
            viewbox-width: 300;
            viewbox-height: 100;
            // Stretch the 300 x 100 chart to the box.
            fit: fill;
            commands: root.chart.line;
            fill: transparent;
            stroke: Theme.accent;
            stroke-width: 2px;
        }

        Rectangle {
            y: parent.height - 1px;
            height: 1px;
            background: Theme.line;
        }
    }

    HorizontalLayout {
        Text {
            text: root.chart.min;
            font-size: 12px;
            color: Theme.text-faint;
        }

        Text {
            text: root.span;
            font-size: 12px;
            color: Theme.text-faint;
            horizontal-alignment: center;
        }

        Text {
            text: root.chart.max;
            font-size: 12px;
            color: Theme.text-faint;
            horizontal-alignment: right;
        }
    }
}

component SensorCell inherits Rectangle {
    in property <string> name;
    in property <string> source;
    in property <string> value;
    min-height: 42px;
    horizontal-stretch: 1;
    min-width: 0px;
    preferred-width: 1px;

    if root.name != "": Rectangle {
        y: parent.height - 1px;
        height: 1px;
        background: Theme.hair;
    }

    HorizontalLayout {
        spacing: 8px;
        Text {
            text: root.name;
            font-size: 14px;
            color: #d6d6d6;
            vertical-alignment: center;
        }

        Text {
            text: root.source;
            font-size: 12px;
            color: Theme.text-faint;
            vertical-alignment: center;
            horizontal-stretch: 1;
            overflow: elide;
        }

        Text {
            text: root.value;
            font-size: 14px;
            color: Theme.text-strong;
            vertical-alignment: center;
            horizontal-alignment: right;
        }
    }
}

export component SystemMonitorPage inherits VerticalLayout {
    property <[int]> windows: [1, 5, 15];
    property <string> span: Live.history-minutes == 1 ? "last minute" : "last " + Live.history-minutes + " minutes";

    spacing: 24px;
    alignment: start;

    HorizontalLayout {
        SectionHeader { title: "Real-time Monitor"; }
        Rectangle { horizontal-stretch: 1; }
        Segmented {
            width: 240px;
            options: ["1 min", "5 min", "15 min"];
            current: Live.history-minutes == 1 ? 0 : Live.history-minutes == 5 ? 1 : 2;
            selected(i) => {
                Live.history-minutes = root.windows[i];
                Live.set-history-minutes(root.windows[i]);
            }
        }
    }

    VerticalLayout {
        padding-left: 20px;
        spacing: 30px;
        HorizontalLayout {
            spacing: 40px;
            ChartBlock {
                chart: Live.charts[0];
                span: root.span;
            }

            ChartBlock {
                chart: Live.charts[1];
                span: root.span;
            }
        }

        HorizontalLayout {
            spacing: 40px;
            ChartBlock {
                chart: Live.charts[2];
                span: root.span;
            }

            ChartBlock {
                chart: Live.charts[3];
                span: root.span;
            }
        }
    }

    VerticalLayout {
        padding-top: 6px;
        spacing: 12px;
        SectionHeader { title: "All Sensors"; }
        VerticalLayout {
            padding-left: 20px;
            for row in Live.sensors: HorizontalLayout {
                spacing: 40px;
                SensorCell {
                    name: row.left.name;
                    source: row.left.source;
                    value: row.left.value;
                }

                SensorCell {
                    name: row.right.name;
                    source: row.right.source;
                    value: row.right.value;
                }
            }
        }
    }
}
