// A stroked 24x24 icon.
export component Icon inherits Path {
    in property <string> data;
    in property <brush> color: #ededed;
    in property <length> size: 22px;
    width: size;
    height: size;
    viewbox-width: 24;
    viewbox-height: 24;
    commands: data;
    stroke: color;
    stroke-width: 1.5px;
    fill: transparent;
}
