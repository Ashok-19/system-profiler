import { Theme } from "../theme.slint";
import { Icon, Icons } from "../icons.slint";

// Three slanted bars: the section marker.
export component Stripes inherits Path {
    in property <brush> color: Theme.accent;
    width: 30px;
    height: 11px;
    viewbox-width: 30;
    viewbox-height: 11;
    commands: "M4 0 L8 0 L4 11 L0 11 Z M12 0 L16 0 L12 11 L8 11 Z M20 0 L24 0 L20 11 L16 11 Z M28 0 L30 0 L30 5.5 L28 11 L24 11 Z";
    fill: color;
    stroke-width: 0px;
}

// "▰▰▰ Title" heading used above every section.
export component SectionHeader inherits HorizontalLayout {
    in property <string> title;
    in property <string> hint;
    spacing: 12px;
    alignment: start;
    VerticalLayout {
        alignment: center;
        Stripes { }
    }

    Text {
        text: root.title;
        font-size: 15px * Theme.text-scale;
        font-weight: 600;
        color: Theme.text-strong;
        vertical-alignment: center;
        accessible-role: text;
    }

    if root.hint != "": Text {
        text: root.hint;
        font-size: 13px * Theme.text-scale;
        color: Theme.text-faint;
        vertical-alignment: center;
    }
}

// Sidebar entry.
export component NavItem inherits Rectangle {
    in property <string> label;
    in property <string> icon;
    in property <bool> active;
    in property <bool> compact;
    callback clicked;

    height: 44px;
    accessible-role: button;
    accessible-label: root.label;
    accessible-action-default => { root.clicked(); }

    background: root.active
        ? @linear-gradient(90deg, Theme.accent.with-alpha(0.6 * Theme.glow) 0%, Theme.accent.with-alpha(0.14 * Theme.glow) 70%, Theme.accent.with-alpha(0) 100%)
        : touch.has-hover ? Theme.row : transparent;

    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }

    Rectangle {
        x: 0;
        width: 3px;
        background: root.active ? Theme.accent : transparent;
    }

    HorizontalLayout {
        padding-left: 20px;
        padding-right: 12px;
        spacing: 14px;
        VerticalLayout {
            alignment: center;
            Icon {
                data: root.icon;
                color: root.active ? Theme.text-strong : #e2e2e2;
            }
        }

        if !root.compact: Text {
            text: root.label;
            font-size: 15px * Theme.text-scale;
            color: root.active ? Theme.text-strong : #e2e2e2;
            vertical-alignment: center;
            overflow: elide;
        }
    }
}

// Group caption in the sidebar ("Device", "Playground", ...).
export component NavGroup inherits Rectangle {
    in property <string> text;
    height: 34px;
    Text {
        x: 20px;
        y: parent.height - self.height - 4px;
        text: root.text;
        font-size: 13px * Theme.text-scale;
        color: Theme.text-faint;
    }
}

// Icon-over-label tab with an accent underline and glow when selected.
export component ModeTab inherits Rectangle {
    in property <string> label;
    in property <string> icon;
    in property <bool> selected;
    in property <bool> enabled: true;
    in property <length> icon-size: 28px;
    callback clicked;

    min-height: 84px;
    // Equal widths regardless of label length.
    min-width: 0px;
    preferred-width: 1px;
    horizontal-stretch: 1;
    accessible-role: button;
    accessible-label: root.label;
    accessible-checked: root.selected;
    accessible-action-default => { if root.enabled { root.clicked(); } }

    background: root.selected
        ? @linear-gradient(0deg, Theme.accent.with-alpha(0.4 * Theme.glow) 0%, Theme.accent.with-alpha(0) 80%)
        : (touch.has-hover && root.enabled) ? @linear-gradient(0deg, Theme.accent.with-alpha(0.16) 0%, Theme.accent.with-alpha(0) 70%) : transparent;

    touch := TouchArea {
        enabled: root.enabled;
        mouse-cursor: root.enabled ? pointer : default;
        clicked => { root.clicked(); }
    }

    VerticalLayout {
        padding-top: 14px;
        padding-bottom: 12px;
        spacing: 10px;
        alignment: center;
        HorizontalLayout {
            alignment: center;
            Icon {
                data: root.icon;
                size: root.icon-size;
                color: !root.enabled ? #5e5e5e : root.selected ? Theme.text-strong : Theme.text-muted;
                stroke-width: 1.4px;
            }
        }

        Text {
            text: root.label;
            horizontal-alignment: center;
            font-size: 15px * Theme.text-scale;
            font-weight: root.selected ? 600 : 400;
            color: !root.enabled ? #5e5e5e : root.selected ? Theme.text-strong : Theme.text-muted;
        }
    }

    Rectangle {
        y: parent.height - self.height;
        height: 3px;
        background: root.selected ? Theme.accent : transparent;
    }
}

// Label/value line with a thick accent bar riding on a hairline.
export component MetricBar inherits VerticalLayout {
    in property <string> label;
    in property <string> value;
    in property <float> percent;
    spacing: 6px;
    padding-bottom: 6px;
    HorizontalLayout {
        Text {
            text: root.label;
            font-size: 13px * Theme.text-scale;
            color: #e2e2e2;
        }

        Text {
            text: root.value;
            font-size: 13px * Theme.text-scale;
            color: Theme.text-strong;
            horizontal-alignment: right;
        }
    }

    track := Rectangle {
        height: 4px;
        Rectangle {
            y: parent.height - 1px;
            height: 1px;
            background: Theme.line;
        }

        Rectangle {
            x: 0;
            width: track.width * clamp(root.percent, 1, 100) / 100;
            background: @linear-gradient(90deg, Theme.accent-dark 0%, Theme.accent 100%);
        }
    }
}

// Plain "key ........ value" line.
export component KeyValue inherits HorizontalLayout {
    in property <string> key;
    in property <string> value;
    in property <length> font-size: 13px * Theme.text-scale;
    Text {
        text: root.key;
        font-size: root.font-size;
        color: Theme.text-muted;
    }

    Text {
        text: root.value;
        font-size: root.font-size;
        color: #e8e8e8;
        horizontal-alignment: right;
    }
}

// Rectangular dropdown in the outlined Armoury style.
export component Select inherits Rectangle {
    in property <[string]> options;
    in property <int> current-index;
    // Shown when `current-index` is out of range (e.g. a custom value).
    in property <string> placeholder;
    callback selected(int);

    width: 180px;
    height: 34px;
    background: Theme.control-bg;
    border-width: 1px;
    border-color: touch.has-hover ? Theme.text-strong : Theme.control-border;
    border-radius: Theme.radius;
    accessible-role: combobox;
    accessible-value: label.text;

    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { popup.show(); }
    }

    HorizontalLayout {
        padding-left: 10px;
        padding-right: 8px;
        spacing: 6px;
        label := Text {
            text: root.current-index >= 0 && root.current-index < root.options.length ? root.options[root.current-index] : root.placeholder;
            font-size: 14px * Theme.text-scale;
            color: Theme.text;
            vertical-alignment: center;
            overflow: elide;
        }

        VerticalLayout {
            alignment: center;
            Icon {
                data: Icons.chevron-down;
                size: 16px;
                color: Theme.text-muted;
            }
        }
    }

    popup := PopupWindow {
        x: 0;
        y: root.height;
        width: root.width;
        Rectangle {
            background: #151515;
            border-width: 1px;
            border-color: Theme.control-border;
            VerticalLayout {
                padding: 1px;
                for option[index] in root.options: Rectangle {
                    height: 34px;
                    background: index == root.current-index ? Theme.accent.with-alpha(0.25) : item-touch.has-hover ? Theme.row : transparent;
                    item-touch := TouchArea {
                        mouse-cursor: pointer;
                        clicked => { root.selected(index); }
                    }

                    Text {
                        x: 10px;
                        text: option;
                        font-size: 14px * Theme.text-scale;
                        color: Theme.text;
                        vertical-alignment: center;
                    }
                }
            }
        }
    }
}

// Row used in settings lists: icon and label on the left, a control on
// the right. Alternate rows set `shaded` for the Armoury striping.
export component SettingRow inherits Rectangle {
    in property <string> icon;
    in property <string> label;
    in property <string> sub;
    in property <bool> shaded;
    in property <bool> dimmed;
    // Grow past the row height when the text needs it.
    min-height: max(Theme.row-height, content.min-height);
    background: root.shaded ? Theme.row : transparent;
    content := HorizontalLayout {
        padding-left: 18px;
        padding-right: 18px;
        spacing: 18px;
        if root.icon != "": VerticalLayout {
            alignment: center;
            Icon {
                data: root.icon;
                size: 24px;
                color: root.dimmed ? Theme.text-faint : #bdbdbd;
                stroke-width: 1.4px;
            }
        }

        VerticalLayout {
            alignment: center;
            spacing: 2px;
            padding-top: 8px;
            padding-bottom: 8px;
            horizontal-stretch: 1;
            Text {
                text: root.label;
                font-size: 15px * Theme.text-scale;
                color: root.dimmed ? Theme.text-dim : Theme.text;
                wrap: word-wrap;
            }

            if root.sub != "": Text {
                text: root.sub;
                font-size: 12px * Theme.text-scale;
                color: Theme.text-dim;
                wrap: word-wrap;
            }
        }

        VerticalLayout {
            alignment: center;
            @children
        }
    }
}

// Section heading plus an indented column of rows.
export component SettingsSection inherits VerticalLayout {
    in property <string> title;
    in property <string> hint;
    spacing: 12px;
    SectionHeader {
        title: root.title;
        hint: root.hint;
    }

    HorizontalLayout {
        padding-left: 20px;
        VerticalLayout {
            @children
        }
    }
}

// Keyboard key, e.g. "Fn".
export component KeyCap inherits Rectangle {
    in property <string> text;
    min-width: 30px;
    height: 28px;
    background: #1e1e1e;
    border-width: 1px;
    border-color: Theme.border;
    border-radius: 3px;
    Rectangle {
        y: parent.height - 3px;
        height: 3px;
        background: Theme.border;
    }

    HorizontalLayout {
        padding-left: 9px;
        padding-right: 9px;
        padding-bottom: 2px;
        Text {
            text: root.text;
            font-size: 13px * Theme.text-scale;
            color: Theme.text-strong;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }
}

// Rectangular ON/OFF switch. `checked` is input only: the owner updates
// it in `toggled`, so bindings to live state are never broken.
export component Switch inherits Rectangle {
    in property <bool> checked;
    in property <bool> enabled: true;
    in property <string> label;
    callback toggled(bool);

    width: 58px;
    height: 26px;
    background: Theme.control-bg;
    border-width: 1px;
    border-color: root.checked ? Theme.text : #6a6a6a;
    border-radius: Theme.radius;
    opacity: root.enabled ? 1 : 0.5;
    accessible-role: switch;
    accessible-label: root.label;
    accessible-checked: root.checked;
    accessible-enabled: root.enabled;
    accessible-action-default => { if root.enabled { root.toggled(!root.checked); } }

    TouchArea {
        enabled: root.enabled;
        mouse-cursor: pointer;
        clicked => { root.toggled(!root.checked); }
    }

    Text {
        x: root.checked ? 7px : parent.width - self.width - 6px;
        text: root.checked ? "ON" : "OFF";
        font-size: 11px * Theme.text-scale;
        font-weight: 700;
        color: root.checked ? Theme.text : Theme.text-faint;
        vertical-alignment: center;
        height: parent.height;
    }

    Rectangle {
        x: root.checked ? 34px : 3px;
        y: 3px;
        width: 20px;
        height: parent.height - 6px;
        border-radius: Theme.radius / 2;
        background: root.checked ? Theme.accent : #6a6a6a;
    }
}

// Outlined rectangular button.
export component OutlineButton inherits Rectangle {
    in property <string> text;
    in property <bool> primary;
    in property <bool> enabled: true;
    callback clicked;

    min-width: 124px;
    height: 40px;
    border-radius: Theme.radius;
    border-width: root.primary ? 0px : 1px;
    border-color: touch.has-hover ? Theme.text-strong : Theme.control-border;
    opacity: root.enabled ? 1 : 0.45;
    background: root.primary ? @linear-gradient(180deg, Theme.accent 0%, Theme.accent-dark 100%) : #151515;
    accessible-role: button;
    accessible-label: root.text;
    accessible-enabled: root.enabled;
    accessible-action-default => { if root.enabled { root.clicked(); } }

    touch := TouchArea {
        enabled: root.enabled;
        mouse-cursor: root.enabled ? pointer : default;
        clicked => { root.clicked(); }
    }

    HorizontalLayout {
        padding-left: 16px;
        padding-right: 16px;
        Text {
            text: root.text;
            font-size: 14px * Theme.text-scale;
            font-weight: root.primary ? 700 : 400;
            color: root.primary ? #120c02 : (touch.has-hover ? Theme.text-strong : #e6e6e6);
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }
}

// Selectable card with a radio dot, title and description.
export component ChoiceCard inherits Rectangle {
    in property <string> label;
    in property <string> description;
    in property <bool> checked;
    in property <bool> enabled: true;
    callback clicked;

    border-radius: Theme.radius;
    border-width: 1px;
    border-color: root.checked ? Theme.accent : touch.has-hover && root.enabled ? Theme.line : #3a3a3a;
    background: root.checked
        ? @linear-gradient(90deg, Theme.accent.with-alpha(0.28 * Theme.glow) 0%, Theme.accent.with-alpha(0) 80%)
        : Theme.panel;
    accessible-role: radio-button;
    accessible-label: root.label;
    accessible-description: root.description;
    accessible-checked: root.checked;
    accessible-enabled: root.enabled;
    accessible-action-default => { if root.enabled { root.clicked(); } }

    touch := TouchArea {
        enabled: root.enabled;
        mouse-cursor: root.enabled ? pointer : default;
        clicked => { root.clicked(); }
    }

    HorizontalLayout {
        padding-left: 18px;
        padding-right: 18px;
        padding-top: 14px;
        padding-bottom: 14px;
        spacing: 16px;
        VerticalLayout {
            alignment: center;
            Rectangle {
                width: 18px;
                height: 18px;
                border-radius: 9px;
                border-width: root.checked ? 5px : 2px;
                border-color: root.checked ? Theme.accent : Theme.text-faint;
                background: root.checked ? Theme.control-bg : transparent;
            }
        }

        VerticalLayout {
            spacing: 4px;
            horizontal-stretch: 1;
            Text {
                text: root.label;
                font-size: 16px * Theme.text-scale;
                color: root.enabled ? Theme.text-strong : Theme.text-dim;
            }

            Text {
                text: root.description;
                font-size: 13px * Theme.text-scale;
                color: #bdbdbd;
                wrap: word-wrap;
            }
        }
    }
}

// Stepped horizontal slider. Dragging previews the value; `committed`
// fires once on release, so the backend is not hit on every step.
export component StepSlider inherits HorizontalLayout {
    in property <int> minimum: 0;
    in property <int> maximum: 100;
    in property <int> step: 1;
    in property <int> value;
    in property <bool> enabled: true;
    in property <string> label;
    in property <string> unit;
    callback committed(int);

    property <int> preview;
    property <bool> dragging;
    property <int> shown: root.dragging ? root.preview : root.value;
    property <float> fraction: max(0, min(1, (root.shown - root.minimum) / (root.maximum - root.minimum)));

    function at(x: length, width: length) -> int {
        return max(root.minimum, min(root.maximum,
            root.minimum + round(x / width * (root.maximum - root.minimum) / root.step) * root.step));
    }

    width: 280px;
    spacing: 12px;
    accessible-role: slider;
    accessible-label: root.label;
    accessible-value: root.shown + root.unit;
    accessible-value-minimum: root.minimum;
    accessible-value-maximum: root.maximum;
    accessible-value-step: root.step;
    accessible-enabled: root.enabled;
    accessible-action-increment => { if root.enabled && root.value < root.maximum { root.committed(min(root.maximum, root.value + root.step)); } }
    accessible-action-decrement => { if root.enabled && root.value > root.minimum { root.committed(max(root.minimum, root.value - root.step)); } }

    Rectangle {
        height: 30px;
        horizontal-stretch: 1;
        opacity: root.enabled ? 1 : 0.5;
        Rectangle {
            y: (parent.height - self.height) / 2;
            height: 4px;
            background: #3a3a3a;
        }

        Rectangle {
            x: 0;
            y: (parent.height - self.height) / 2;
            width: (parent.width - 12px) * root.fraction + 6px;
            height: 4px;
            background: @linear-gradient(90deg, Theme.accent-dark 0%, Theme.accent 100%);
        }

        Rectangle {
            x: (parent.width - self.width) * root.fraction;
            y: (parent.height - self.height) / 2;
            width: 12px;
            height: 22px;
            border-radius: Theme.radius;
            background: touch.has-hover || root.dragging ? Theme.text-strong : Theme.accent;
        }

        touch := TouchArea {
            enabled: root.enabled;
            mouse-cursor: pointer;
            pointer-event(event) => {
                if event.button == PointerEventButton.left && event.kind == PointerEventKind.down {
                    root.preview = root.at(self.mouse-x, self.width);
                    root.dragging = true;
                }
                if event.button == PointerEventButton.left && event.kind == PointerEventKind.up && root.dragging {
                    root.preview = root.at(self.mouse-x, self.width);
                    root.dragging = false;
                    if root.preview != root.value {
                        root.committed(root.preview);
                    }
                }
            }
            moved => {
                if root.dragging {
                    root.preview = root.at(self.mouse-x, self.width);
                }
            }
        }
    }

    Text {
        width: 48px;
        text: root.shown + root.unit;
        font-size: 14px * Theme.text-scale;
        color: Theme.text-strong;
        horizontal-alignment: right;
        vertical-alignment: center;
    }
}

// Row of joined buttons; one is selected.
export component Segmented inherits HorizontalLayout {
    in property <[string]> options;
    in property <int> current: -1;
    in property <bool> enabled: true;
    callback selected(int);

    spacing: -1px;
    for option[index] in root.options: Rectangle {
        property <bool> on: index == root.current;
        min-width: 0px;
        preferred-width: 1px;
        horizontal-stretch: 1;
        height: 36px;
        border-width: 1px;
        border-color: self.on ? Theme.accent : #5a5a5a;
        background: self.on
            ? @linear-gradient(0deg, Theme.accent.with-alpha(0.38 * Theme.glow) 0%, Theme.accent.with-alpha(0.06) 100%)
            : touch.has-hover && root.enabled ? #1c1c1c : Theme.control-bg;
        opacity: root.enabled ? 1 : 0.5;
        accessible-role: button;
        accessible-label: option;
        accessible-checked: self.on;
        accessible-action-default => { if root.enabled { root.selected(index); } }

        touch := TouchArea {
            enabled: root.enabled;
            mouse-cursor: pointer;
            clicked => { root.selected(index); }
        }

        Text {
            text: option;
            font-size: 13px * Theme.text-scale;
            color: parent.on ? Theme.text-strong : #cfcfcf;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }
}

// Outlined panel with bright corner brackets.
export component BracketPanel inherits Rectangle {
    background: Theme.panel;
    border-width: 1px;
    border-color: Theme.border;
    border-radius: Theme.radius;

    Path {
        x: 0;
        y: 0;
        width: 12px;
        height: 12px;
        viewbox-width: 12;
        viewbox-height: 12;
        commands: "M1 12 L1 1 L12 1";
        stroke: #e6e6e6;
        stroke-width: 2px;
    }

    Path {
        x: parent.width - 12px;
        y: 0;
        width: 12px;
        height: 12px;
        viewbox-width: 12;
        viewbox-height: 12;
        commands: "M0 1 L11 1 L11 12";
        stroke: #e6e6e6;
        stroke-width: 2px;
    }

    Path {
        x: 0;
        y: parent.height - 12px;
        width: 12px;
        height: 12px;
        viewbox-width: 12;
        viewbox-height: 12;
        commands: "M1 0 L1 11 L12 11";
        stroke: #e6e6e6;
        stroke-width: 2px;
    }

    Path {
        x: parent.width - 12px;
        y: parent.height - 12px;
        width: 12px;
        height: 12px;
        viewbox-width: 12;
        viewbox-height: 12;
        commands: "M0 11 L11 11 L11 0";
        stroke: #e6e6e6;
        stroke-width: 2px;
    }

    VerticalLayout {
        padding: 22px;
        spacing: 20px;
        alignment: start;
        @children
    }
}

// Single-line text box in the outlined control style.
export component TextField inherits Rectangle {
    in-out property <string> text <=> input.text;
    in property <string> placeholder;
    in property <string> label;
    callback edited(string);

    height: 36px;
    background: Theme.control-bg;
    border-width: 1px;
    border-color: input.has-focus ? Theme.accent : touch.has-hover ? Theme.text-strong : Theme.control-border;
    border-radius: Theme.radius;
    accessible-role: text-input;
    accessible-label: root.label;
    accessible-value: root.text;
    accessible-placeholder-text: root.placeholder;

    touch := TouchArea {
        mouse-cursor: MouseCursor.text;
        clicked => { input.focus(); }
    }

    if root.text == "": Text {
        x: 10px;
        width: parent.width - 20px;
        height: parent.height;
        text: root.placeholder;
        font-size: 14px * Theme.text-scale;
        color: Theme.text-faint;
        vertical-alignment: center;
        overflow: elide;
    }

    input := TextInput {
        x: 10px;
        width: parent.width - 20px;
        height: parent.height;
        font-size: 14px * Theme.text-scale;
        color: Theme.text;
        selection-background-color: Theme.accent.with-alpha(0.4);
        vertical-alignment: center;
        single-line: true;
        edited => { root.edited(self.text); }
    }
}
