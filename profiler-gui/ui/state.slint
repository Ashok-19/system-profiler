// Data shared between Rust and the UI.

export struct Metric {
    label: string,
    value: string,
    percent: float,
}

export struct Fact {
    key: string,
    value: string,
}

// One "Systems Monitor" block (CPU, GPU, Fan, Memory).
export struct MonitorPanel {
    title: string,
    bars: [Metric],
    rows: [Fact],
}

// One System Monitor chart; `line`/`area` are path commands on a
// 300 x 100 viewbox.
export struct Chart {
    title: string,
    now: string,
    min: string,
    max: string,
    line: string,
    area: string,
}

export struct Sensor {
    name: string,
    source: string,
    value: string,
}

// Two table cells side by side; `right.name` is empty for a lone cell.
export struct SensorRow {
    left: Sensor,
    right: Sensor,
}

// Live sensor readings, refreshed by the monitor thread.
export global Live {
    in property <[MonitorPanel]> panels;
    in property <int> battery-percent: -1;
    in property <bool> on-ac: true;
    // Battery Care: one status line and the details list.
    in property <string> battery-status;
    in property <[Fact]> battery-facts;
    // System Monitor: CPU temperature, CPU usage, package power, CPU fan.
    in property <[Chart]> charts;
    in property <[SensorRow]> sensors;
    in-out property <int> history-minutes: 1;
    callback set-history-minutes(int);
}

// Static facts about this machine.
export global Machine {
    in property <string> name: "ASUS LAPTOP";
    in property <string> board;
    in property <string> cpu;
    in property <string> dgpu;
    in property <int> cpu-threads;
    in property <string> cpufreq-driver;
    // System Information rows.
    in property <[Fact]> details;
}

// State owned by asusd. Setters are optimistic; the daemon thread
// re-reads the real values afterwards.
export global Device {
    in property <bool> daemon-ok;
    in property <string> daemon-version;
    // 0 = Silent, 1 = Performance, 2 = Turbo, -1 = unknown/unsupported.
    in-out property <int> mode: -1;
    callback set-mode(int);
    // Battery charge limit in percent, -1 if unsupported.
    in-out property <int> charge-limit: -1;
    callback set-charge-limit(int);
    // Charge to 100% once; asusd restores the limit when unplugged.
    callback one-shot-charge();
    // Limit in force before a one-shot charge (this session only), else -1.
    in-out property <int> one-shot-from: -1;

    // Automatic switching when the power source changes (asusd applies it,
    // even while this app is closed). Modes use the same indices as `mode`.
    in-out property <bool> auto-switch;
    callback set-auto-switch(bool);
    in-out property <int> mode-on-ac: -1;
    callback set-mode-on-ac(int);
    in-out property <int> mode-on-battery: -1;
    callback set-mode-on-battery(int);

    // CPU energy-performance preference that asusd applies with each mode.
    // EPP indices: 0 Default, 1 Performance, 2 Balance performance,
    // 3 Balance power, 4 Power.
    in-out property <bool> linked-epp;
    callback set-linked-epp(bool);
    in-out property <[int]> mode-epp: [-1, -1, -1];
    callback set-mode-epp(int /* mode */, int /* epp */);
    // Live EPP of cpu0 as the kernel reports it, e.g. "balance_power".
    in property <string> cpu-epp;
}

export struct Effect {
    // asusd's AuraModeNum: 0 Static, 1 Breathe, 2 RainbowCycle,
    // 3 RainbowWave, 10 Pulse.
    mode: int,
    name: string,
}

// Keyboard backlight, owned by asusd's aura interface.
export global Lighting {
    in property <bool> available;
    // Effects the keyboard supports, in display order.
    in property <[Effect]> effects;
    in-out property <int> mode: -1;
    in-out property <color> colour: #a60000;
    // 0 slow, 1 medium, 2 fast.
    in-out property <int> speed: 1;
    // 0 right, 1 left (Rainbow only).
    in-out property <int> direction;
    // 0 off .. 3 high; -1 unknown.
    in-out property <int> brightness: -1;
    // Sends mode, colour, speed and direction together.
    callback apply-effect();
    callback set-brightness(int);

    in-out property <bool> on-boot;
    in-out property <bool> on-awake;
    in-out property <bool> on-sleep;
    in-out property <bool> on-shutdown;
    // Sends the four on-* flags together.
    callback apply-power();
}

// Built-in panel and touchpad (Display page). Filled by `refresh`, which
// the page calls when it opens.
export global Screen {
    in property <bool> available;
    in property <string> output;
    in property <string> resolution;
    // Diagonal, e.g. "15.5″".
    in property <string> size;
    // Distinct refresh rates, fastest first, e.g. "144 Hz".
    in property <[string]> rates;
    in-out property <int> current: -1;
    // A command is running.
    in-out property <bool> busy;
    callback refresh();
    callback set-rate(int);

    in property <bool> has-touchpad;
    in property <string> touchpad-name;
    in-out property <bool> touchpad-on;
    callback set-touchpad(bool);
}
